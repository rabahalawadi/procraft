{
  "schema": 1,
  "id": "io.github.artcraftandroid.fullscreen",
  "name": "Fullscreen",
  "version": "1.0.0",
  "holds": ["hooks"],
  "publisher": { "name": "raba7" },
  "description": "Immersive fullscreen canvas mode for ProCraft by raba7. Seamlessly switch between windowed and fullscreen display with F11 or Alt+Enter, featuring optional high-refresh rate exclusive fullscreen.",
  "compat": { "procraft": { "interface": 2 } },
  "permissions": [],
  "hooks": ["fullscreen"],
  "controls": [
    { "key": "enabled", "type": "switch", "label": "Enable fullscreen features", "starts": true },
    { "key": "exclusive", "type": "switch", "label": "Exclusive fullscreen (max refresh rate)", "starts": false, "under": "enabled" },
    { "key": "shortcuts", "type": "switch", "label": "Keyboard shortcuts (F11 / Alt+Enter)", "starts": true, "under": "enabled" }
  ],
  "actions": [
    { "key": "toggle", "label": "Toggle Fullscreen" }
  ]
}
